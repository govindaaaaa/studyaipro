# StudyAI Pro - MERN Stack Configuration
# Copy this file to .env and fill in your values

# ==============================================
# Node.js Backend Configuration (backend-node)
# ==============================================

# Server
PORT=8000
NODE_ENV=development

# MongoDB Database
MONGODB_URL=mongodb://localhost:27017/studyai_pro
DB_NAME=studyai_pro

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE_MINUTES=10080

# Groq API (Required) - Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG Microservice URL
RAG_SERVICE_URL=http://localhost:8001

# Text Processing
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Email Configuration (Optional - for sharing features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=StudyAI Pro <your_email@gmail.com>

# Twilio (Optional - for WhatsApp sharing)
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cloudinary (Optional - for file storage)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ==============================================
# Python RAG Microservice Configuration (rag-service)
# ==============================================

# Server Port
# PORT=8001

# FAISS Storage Directory
# FAISS_DIR=/tmp/faiss

# Sentence Transformer Model
# MODEL_NAME=all-MiniLM-L6-v2

# ==============================================
# React Frontend Configuration (frontend)
# ==============================================

# API URL
# VITE_API_URL=http://localhost:8000
