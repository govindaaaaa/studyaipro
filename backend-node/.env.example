# Backend Node.js Environment Variables

# Server Configuration
NODE_ENV=development
PORT=8000

# MongoDB Atlas
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/studyai_pro?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_MINUTES=10080

# Groq AI API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# RAG Microservice URL
# Local development:
RAG_SERVICE_URL=http://localhost:8001
# Production (replace with your Render RAG service URL):
# RAG_SERVICE_URL=https://studyai-rag-service.onrender.com

# CORS Allowed Origins (comma-separated)
# Local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173
# Production (add your Vercel URL):
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@studyai.com

# Optional: Twilio (WhatsApp notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
